# ─────────────────────────────────────────────────────────────────────────────
# Backend
# ─────────────────────────────────────────────────────────────────────────────

# Server-side only. Never prefix this NEXT_PUBLIC_ -- doing so would ship the
# ERP's address to every browser instead of keeping it behind this server.
JC_API_URL=http://localhost:8000

# Only needed when vehicle photos are served from a different address than the
# API -- an internal API host with public media, say. Next will not optimise an
# image whose host it has not been told about, so this must match the host in
# the photo URLs jc-portal generates (its APP_URL). Defaults to JC_API_URL.
# JC_MEDIA_URL=https://portal.jcexport.jp

# ─────────────────────────────────────────────────────────────────────────────
# This site
# ─────────────────────────────────────────────────────────────────────────────

# Absolute origin, used for canonical URLs and to allow this site's own
# requests through the API's origin check. Defaults to https://jcexport.jp.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
WEBSITE_ALLOWED_ORIGINS=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Contact details
#
# Everything the site prints about how to reach JC comes from here. Each has a
# sensible default except the phone numbers: an unset number hides its button
# rather than falling back to an invented one, because a made-up number is a
# real number belonging to somebody else.
# ─────────────────────────────────────────────────────────────────────────────

# Defaults to sales@jcexport.jp.
NEXT_PUBLIC_SALES_EMAIL=sales@jcexport.jp

# Printed as written, in international format. The dial link is derived from
# it by stripping everything that is not a digit or a plus, so punctuation is
# free: "+81 3 1234 5678" dials as +81312345678.
NEXT_PUBLIC_PHONE=

# WhatsApp, in international format with no plus, spaces or dashes
# (e.g. 819012345678). This trade runs on WhatsApp, so it is worth setting --
# but every WhatsApp button hides itself while it is empty.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Where the people answering are. Defaults to "Export desk" / "Japan".
NEXT_PUBLIC_OFFICE_LABEL=
NEXT_PUBLIC_OFFICE_LOCATION=

# ─────────────────────────────────────────────────────────────────────────────
# Social accounts
#
# Each icon appears only once its URL is set. Leave a line blank and that
# network simply has no icon, rather than a button that goes nowhere.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_LINKEDIN_URL=
