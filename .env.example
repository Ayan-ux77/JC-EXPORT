# Server-side only. Never prefix this NEXT_PUBLIC_ -- doing so would ship the
# ERP's address to every browser instead of keeping it behind this server.
JC_API_URL=http://localhost:8000

NEXT_PUBLIC_SITE_URL=http://localhost:3000
WEBSITE_ALLOWED_ORIGINS=http://localhost:3000

# WhatsApp number for the "message us" buttons on vehicle cards and detail
# pages, in international format with no leading + or spaces (e.g. 254712345678).
# This runs on WhatsApp, not contact forms -- but the button is hidden
# entirely when this is unset, rather than rendering a link that goes nowhere.
NEXT_PUBLIC_WHATSAPP_NUMBER=254712345678
